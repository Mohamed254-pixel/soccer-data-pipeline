# API-FOOTBALL
API_KEY=your_api_football_key
FOOTBALL_LEAGUE_ID=39
FOOTBALL_SEASON=2024
# Phase 2 refreshes these starting years (2026 means the 2026-27 season).
# FOOTBALL_SEASON is retained for legacy snapshot helpers only.
FOOTBALL_SEASONS=2026
INCREMENTAL_OVERLAP_DAYS=14
FULL_RECONCILE_DAYS=28

# Explicit provider selection; api_football remains the backward-compatible default.
# Set football_data for 2026-27 only after approved migrations 003 and 004.
FOOTBALL_SOURCE=api_football
FOOTBALL_DATA_API_KEY=your_private_football_data_token

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=soccer_app
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=soccer_db

# Docker/Airflow (macOS local development)
AIRFLOW_UID=50000
# Generate with: python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# Paste the generated key below in your private .env file, not in this example.
FERNET_KEY=
# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AIRFLOW__API_AUTH__JWT_SECRET=

# Optional Phase 3 support; blank bucket keeps the local pipeline's S3 archival off.
PIPELINE_RAW_S3_BUCKET=
PIPELINE_RAW_S3_PREFIX=raw
PIPELINE_S3_EXPECTED_OWNER=
# RDS uses VERIFY_IDENTITY plus an existing trusted CA bundle; local defaults stay unchanged.
DB_SSL_MODE=PREFERRED
DB_SSL_CA=
